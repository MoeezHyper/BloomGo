# Copy to backend/.env when using a real Firebase project (leave unset for the local emulator).
FIREBASE_PROJECT_ID=your-project
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Save the file next to this one (service-account*.json is git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Google sign-in: Firebase console -> Authentication -> Sign-in method -> Google ->
# "Web SDK configuration" shows the Web client ID and secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
